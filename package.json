{
  "name": "alphas-de-basile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "voices": "bash scripts/generate-voices.sh",
    "voices:setup": "python3 -m venv scripts/.venv-kokoro && scripts/.venv-kokoro/bin/python -m pip install --upgrade pip && scripts/.venv-kokoro/bin/python -m pip install mlx-audio 'misaki[en]'",
    "voices:check": "scripts/.venv-kokoro/bin/python scripts/voice-generator.py --check",
    "voices:neural": "scripts/.venv-kokoro/bin/python scripts/voice-generator.py",
    "voices:samples": "scripts/.venv-kokoro/bin/python scripts/voice-generator.py --comparison tmp/voice-comparison",
    "voices:report": "scripts/.venv-kokoro/bin/python scripts/voice-generator.py --report",
    "sfx": "python3 scripts/generate-sfx.py",
    "alphas": "python3 scripts/prepare-alphas.py",
    "audio": "npm run voices && npm run sfx",
    "lint": "tsc -b --noEmit",
    "test": "node --test scripts/words.test.mjs scripts/letters.test.mjs scripts/wordgame.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
